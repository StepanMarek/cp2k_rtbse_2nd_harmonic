&GLOBAL
	PROJECT_NAME CO
	RUN_TYPE RT_PROPAGATION
&END GLOBAL

&MOTION
	&MD
		! 3 fs before 20 fs run from T0
		! 20 fs = 2500 steps, 3 fs = 375 steps
		STEPS 5375
		TIMESTEP [fs] 0.008
	&END MD
&END MOTION

&FORCE_EVAL
	METHOD QS
	&DFT
		BASIS_SET_FILE_NAME BASIS_GTH_MOLOPT_AUG_for_excited_states
		BASIS_SET_FILE_NAME BASIS_GTH_MOLOPT_AUG_for_excited_states_RI
		POTENTIAL_FILE_NAME GTH_POTENTIALS
		&MGRID
			CUTOFF 400
			REL_CUTOFF 50
		&END MGRID
		&QS
			METHOD GPW
			EPS_DEFAULT 1.0E-10
		&END QS
		&SCF
			SCF_GUESS RESTART
			EPS_SCF 1e-9
			MAX_SCF 200
			ADDED_MOS -1
			&MIXING
				METHOD PULAY_MIXING
				PULAY_ALPHA 0.2
			&END MIXING
		&END SCF
		&XC
			&XC_FUNCTIONAL PBE
			&END XC_FUNCTIONAL
		&END XC
		&POISSON
			PERIODIC NONE
			POISSON_SOLVER WAVELET
		&END POISSON
		&REAL_TIME_PROPAGATION
			&RTBSE
			&END RTBSE
			APPLY_DELTA_PULSE .FALSE.
			EPS_ITER 1e-7
			MAX_ITER 20
			MAT_EXP BCH
			EXP_ACCURACY 1e-10
			INITIAL_WFN RT_RESTART
			&PRINT
				&MOMENTS
					FILENAME MOMENTS
				&END MOMENTS
				&MOMENTS_FT
					START_TIME [fs] 3.0
				&END MOMENTS_FT
				&FIELD
					FILENAME FIELD
				&END FIELD
				&POLARIZABILITY
					FILENAME POL
					ELEMENT 1 1
				&END POLARIZABILITY
			&END PRINT
		&END REAL_TIME_PROPAGATION
		&EFIELD
			INTENSITY 1.0e14
			PHASE 0.0
			! Lowest energy excitation in x direction
			WAVELENGTH [nm] 122.529
			POLARISATION 1 0 0
			ENVELOP GAUSSIAN
			&GAUSSIAN_ENV
				SIGMA [fs] 1.0
				T0 [fs] 3.0
			&END GAUSSIAN_ENV
		&END EFIELD
	&END DFT
	&PROPERTIES
		&BANDSTRUCTURE
			&GW
				NUM_TIME_FREQ_POINTS 30
			&END GW
		&END BANDSTRUCTURE
	&END PROPERTIES
	&SUBSYS
		&CELL
			PERIODIC NONE
			ABC 10.0 10.0 10.0
		&END CELL
		&TOPOLOGY
			&CENTER_COORDINATES
			&END CENTER_COORDINATES
		&END TOPOLOGY
		&COORD
			C 0.000 0.0 0.0
			O 1.283 0.0 0.0
		&END COORD
		&KIND C
			POTENTIAL GTH-PBE
			BASIS_SET ORB aug-SZV-MOLOPT-GTH
			BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-GTH_N_RI_067_s_p_d_f_g_h_i_6_5_5_3_0_0_0_error_1.9e-07
		&END KIND
		&KIND O
			POTENTIAL GTH-PBE
			BASIS_SET ORB aug-SZV-MOLOPT-GTH
			BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-GTH_N_RI_078_s_p_d_f_g_h_i_7_6_5_4_0_0_0_error_1.6e-07
		&END KIND
	&END SUBSYS
&END FORCE_EVAL
